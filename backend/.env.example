NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:4173

# PostgreSQL
# Docker Compose: use host.docker.internal (not 127.0.0.1) to reach host Postgres.
DATABASE_URL=postgresql://nodvira_app:change-this-password@127.0.0.1:5432/nodvira
DB_SSL=false
DB_POOL_MAX=10

# Admin oturumu (canlı ortamda uzun ve rastgele bir değer kullanılacak)
SESSION_SECRET=change-this-to-a-long-random-value
SESSION_MAX_AGE_HOURS=8

# İlk admin hesabı
ADMIN_BOOTSTRAP_USERNAME=nodvira_admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-at-least-16-random-characters
ADMIN_BOOTSTRAP_NAME=NODVIRA Yönetici

# E-posta bildirimi: geliştirmede log, canlıda smtp
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@nodvira.com
CONTACT_NOTIFICATION_TO=info@nodvira.com

# Görsel yüklemeleri
# Docker Compose overrides this to /app/backend/uploads and bind-mounts
# host /var/www/nodvira-data/uploads into that path.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
UNUSED_UPLOAD_GRACE_HOURS=24
